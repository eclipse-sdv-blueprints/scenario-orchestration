# TTRT Global Scheduler - Node Configuration File
# Defines hardware specs and available resources for each node.
#
# This file is a template: install-timpani-o.sh fills in the two node keys below
# from MASTER_NODE_NAME and GUEST_NODE_NAME in test_script/config.env (default:
# the real hostname of each node). The guest name is the same one used by the guest
# nodeagent, the workload YAMLs and timpani-n, so they always match.

nodes:
  ${MASTER_NODE_NAME}:
    # Master node
    available_cpus: [12, 13, 14, 15]
    max_memory_mb: 31000
    architecture: "x86_64"
    location: "local_master_pc"
    description: "Master node"
  ${GUEST_NODE_NAME}:
    # Guest node
    available_cpus: [12, 13, 14, 15]
    max_memory_mb: 31114
    architecture: "x86_64"
    location: "guest_node"
    description: "Guest node"